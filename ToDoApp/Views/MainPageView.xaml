<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ToDoApp.Views.MainPageView"
             BackgroundColor="{StaticResource AppBackground}">

    <Grid>

        <!-- ===================================================================== -->
        <!-- ===== LAYER 1: SCROLLABLE CONTENT                                   ===== -->
        <!-- ===================================================================== -->

        <ScrollView Orientation="Vertical">

            <VerticalStackLayout Padding="16,10"
                                 Spacing="12">

                <!-- ~~~ HEADER: greeting and settings icon ~~~ -->

                <Grid Padding="0,0" 
                    Margin="0,0,0,20">

                    <!-- Row Template -->

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                    </Grid.RowDefinitions>

                    <!-- Column Template -->

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <!-- Username Greeting -->

                    <HorizontalStackLayout Grid.Row="0"
                                           Grid.Column="0"
                                           Spacing="10">


                        <!-- App Label -->

                        <Label VerticalOptions="Center"
                               Text="Username"
                               FontSize="Title"
                               FontAttributes="Bold"
                               TextColor="{StaticResource AccentColor}"/>

                    </HorizontalStackLayout>

                    <!-- Settings Button Icon -->

                    <Image Grid.Row="0"
                           Grid.Column="1"
                           VerticalOptions="Center"
                           HorizontalOptions="End"
                           Source="solar_settings_minimalistic_bold_48px.png"/>

                </Grid>

                <!-- ~~~ END HEADER ~~~ -->

                <!-- ~~~ SEARCH BAR (placeholder, not functional yet) ~~~ -->

                <Border Style="{StaticResource SearchForTaskBorder}">
                    <HorizontalStackLayout Padding="18, 0, 18, 0"
                                           Spacing="12">

                        <Image Source="solar_magnifier_linear_16px.png"/>

                        <Label Text="Search tasks..."
                               TextColor="{StaticResource TextMuted}"
                               FontSize="Subtitle"
                               VerticalOptions="Center"/>

                    </HorizontalStackLayout>
                </Border>

                <!-- ~~~ END SEARCH BAR ~~~ -->

                <!-- ~~~ PROGRESS CARD: "Today's Progress" ~~~ -->

                <Border Style="{StaticResource TasksProgressBorder}">

                    <Grid>

                        <!-- Row Template -->

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>

                        <!-- Column Template -->

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6*"></ColumnDefinition>
                            <ColumnDefinition Width="4*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Text="Today's Progress"
                               TextColor="{StaticResource TextPrimary}"
                               FontSize="Medium"
                               FontAttributes="Bold"/>
                        <Label Grid.Row="1"
                               Grid.Column="0"
                               Text="{Binding NumberOfCompletedTasks}"
                               TextColor="{StaticResource TextSecondary}"
                               FontSize="Subtitle"/>

                    </Grid>


                </Border>

                <!-- ~~~ END PROGRESS CARD ~~~ -->

                <!-- ~~~ LOADING AND ERROR FEEDBACK ~~~ -->
                <!-- Bound to IsBusy / HasError / ErrorMessage in MainPageViewModel -->

                <!-- Spinner, visible while a request to the server is running -->
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}" />

                <!-- Hint, visible only while a request is running (a free-tier server can take a while to wake up) -->
                <Label Text="Connecting to the server. The first request can take a while."
                       IsVisible="{Binding IsBusy}"
                       TextColor="{StaticResource TextMuted}"
                       FontSize="Caption" />

                <!-- Error text, visible only when ErrorMessage is not empty -->
                <Label Text="{Binding ErrorMessage}"
                       IsVisible="{Binding HasError}"
                       TextColor="Red" />

                <!-- ~~~ END LOADING AND ERROR FEEDBACK ~~~ -->

                <!-- ~~~ TASK LIST ~~~ -->

                <CollectionView x:Name="TaskView" 
                                ItemsSource="{Binding TaskList}">

                    <!-- Item Layout -->

                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
                    </CollectionView.ItemsLayout>

                    <!-- Item Template: how ONE task is drawn -->

                    <CollectionView.ItemTemplate>

                        <DataTemplate>

                            <!-- SwipeView wrapper for every task (swipe left to delete) -->

                            <SwipeView>

                                <!-- Swipe action: Delete -->

                                <SwipeView.RightItems>
                                    <SwipeItems>
                                        <SwipeItem Text="Delete"
                                                   BackgroundColor="Red"
                                                   Command="{Binding BindingContext.DeleteTaskCommand, Source={x:Reference TaskView}}"
                                                   CommandParameter="{Binding .}"/>
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <!-- Task Border: tap anywhere on the row to edit the description -->

                                <Border Style="{StaticResource TaskBorderUnchecked}">

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding BindingContext.ModifyTaskDescriptionCommand, Source={x:Reference TaskView}}"
                                                               CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>

                                    <HorizontalStackLayout Spacing="20">

                                        <!-- Task Status Icon (Done / Undone): tap to toggle -->

                                        <Image Source="{Binding CheckboxIconSource}" 
                                               VerticalOptions="Center">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding BindingContext.ModifyTaskStateCommand, Source={x:Reference TaskView}}"
                                                                       CommandParameter="{Binding .}"/>
                                            </Image.GestureRecognizers>
                                        </Image>

                                        <!-- Task Description Label -->

                                        <Label Text="{Binding TaskDescription}" 
                                               VerticalOptions="Center" 
                                               TextColor="{StaticResource TextPrimary}"
                                               FontAttributes="Bold"
                                               FontSize="16"></Label>

                                    </HorizontalStackLayout>

                                </Border>

                            </SwipeView>


                        </DataTemplate>

                    </CollectionView.ItemTemplate>

                </CollectionView>

                <!-- ~~~ END TASK LIST ~~~ -->

            </VerticalStackLayout>

        </ScrollView>

        <!-- ===== END LAYER 1 ===== -->

        <!-- ===================================================================== -->
        <!-- ===== LAYER 2: FLOATING ADD BUTTON (bottom right)                   ===== -->
        <!-- ===================================================================== -->

        <Image Source="solar_add_circle_bold_96px.png"
               VerticalOptions="End"
               HorizontalOptions="End"
               Margin="16,0">

            <!-- Add Task Button Gesture Recognizer: opens the entry panel -->

            <Image.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ShowAddOrModifyTaskCommand}"/>
            </Image.GestureRecognizers>

        </Image>

        <!-- ===== END LAYER 2 ===== -->

        <!-- ===================================================================== -->
        <!-- ===== LAYER 3: TASK ENTRY PANEL (add or edit a task)                ===== -->
        <!-- ===================================================================== -->

        <Border x:Name="EntryBorder"
                Style="{StaticResource TaskEntryBorder}"
                IsVisible="{Binding IsEntryVisible}">

            <Grid>

                <!-- Row Template -->

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>

                <!-- Column Template -->

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"></ColumnDefinition>
                    <ColumnDefinition Width="5*"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <!-- ~~~ ENTRY ROW: icon and text field ~~~ -->

                <HorizontalStackLayout Grid.Row="0"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="2"
                                       Spacing="5">

                    <!-- Task Description Entry Icon -->

                    <Image Source="solar_check_square_linear_24px.png"
                           VerticalOptions="Center"/>

                    <!-- Task Description Entry -->

                    <Entry x:Name="OnEntryAdd"
                           Text="{Binding NewTaskDescription, Mode=TwoWay}"
                           Placeholder="Tap 'Enter' to create subtasks"
                           VerticalOptions="Center"
                           FontSize="Small"
                           PlaceholderColor="{StaticResource TextMuted}"
                           TextColor="{StaticResource TextPrimary}"
                           FontAttributes="None"/>

                </HorizontalStackLayout>

                <!-- ~~~ END ENTRY ROW ~~~ -->

                <!-- ~~~ REMINDER BUTTON (not functional yet) ~~~ -->

                <Border Style="{StaticResource TaskReminderBorder}"
                        Grid.Row="1"
                        Grid.Column="0">

                    <HorizontalStackLayout Spacing="5"
                                           HorizontalOptions="Center">

                        <!-- Task Reminder Icon -->

                        <Image Source="solar_alarm_linear_12px.png"
                               VerticalOptions="Center"/>

                        <!-- Task Reminder Label -->

                        <Label Text="Set Reminder"
                               TextColor="{StaticResource TextSecondary}"
                               FontSize="Caption"
                               FontAttributes="Bold"
                               VerticalOptions="Center"/>

                    </HorizontalStackLayout>

                </Border>

                <!-- ~~~ END REMINDER BUTTON ~~~ -->

                <!-- ~~~ DONE BUTTON: saves the task (create or edit) ~~~ -->

                <Label x:Name="DoneButton"
                       Grid.Row="1"
                       Grid.Column="1"
                       Text="Done"
                       TextColor="{Binding DoneButtonTextColor}"
                       HorizontalOptions="End"
                       VerticalOptions="Center"
                       FontAttributes="Bold"
                       FontSize="14">

                    <!-- Done Button Gesture Recognizer -->

                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AddOrModifyTaskCommand}"/>
                    </Label.GestureRecognizers>

                </Label>

                <!-- ~~~ END DONE BUTTON ~~~ -->

            </Grid>

        </Border>

        <!-- ===== END LAYER 3 ===== -->

    </Grid>

</ContentPage>